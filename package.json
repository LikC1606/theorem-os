{
  "name": "theorem-os",
  "version": "0.1.0",
  "private": true,
  "description": "Composable mathematical research agents with Lean-verified proof acceptance and replaceable research components.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "bin": {
    "theorem-os": "bin/math.ts",
    "deepscientist-math": "bin/math.ts"
  },
  "scripts": {
    "math": "bun bin/math.ts",
    "build": "bun scripts/build.ts",
    "build:site": "bun scripts/build-site.ts",
    "test:site": "node scripts/test-landing.mjs && node scripts/test-site.mjs && node scripts/test-landing-motion.mjs && node scripts/test-feedback.mjs",
    "typecheck:site": "tsc --noEmit --project docs/web/tsconfig.json",
    "build:web": "bun scripts/build-web.ts",
    "web": "bun apps/web/server.ts",
    "typecheck:web": "tsc --project apps/web/tsconfig.json && tsc --project apps/web/client/tsconfig.json",
    "test:web-ui": "bun scripts/test-web-ui.ts",
    "test:web-preparation": "bun scripts/test-web-preparation.ts",
    "test:web-recovery": "bun scripts/test-web-recovery.ts",
    "test:web-results": "bun scripts/test-web-results.ts",
    "test:web-drafts": "bun scripts/test-web-drafts.ts",
    "test:web-draft-recovery": "bun scripts/test-web-draft-recovery.ts",
    "test:web-run-monitor": "bun scripts/test-web-run-monitor.ts",
    "test:web-history": "bun scripts/test-web-history.ts",
    "test:web-source-diff": "bun scripts/test-web-source-diff.ts",
    "test:web-source-reader": "bun scripts/test-web-source-reader.ts",
    "test:web-editor-navigation": "bun scripts/test-web-editor-navigation.ts",
    "test:web-editor-replace": "bun scripts/test-web-editor-replace.ts",
    "test:web-editor-review": "bun scripts/test-web-editor-review.ts",
    "test:web-source-handoff": "bun scripts/test-web-source-handoff.ts",
    "test:web-activity": "bun scripts/test-web-activity.ts",
    "test:web-modules": "bun scripts/test-web-modules.ts",
    "test:web-module-plan": "bun scripts/test-web-module-plan.ts",
    "test:web-performance": "bun scripts/test-web-performance.ts",
    "test:web-motion": "bun scripts/test-web-motion.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "1.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "diff": "9.0.0",
    "esbuild": "0.25.12",
    "gsap": "3.15.0",
    "lucide": "1.57.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
