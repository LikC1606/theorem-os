{
  "name": "theorem-os",
  "version": "0.1.0",
  "private": true,
  "description": "Composable mathematical research agents with Lean-verified proof acceptance and replaceable research components.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "bin": {
    "theorem-os": "bin/math.ts",
    "deepscientist-math": "bin/math.ts"
  },
  "scripts": {
    "math": "bun bin/math.ts",
    "build": "bun scripts/build.ts",
    "build:site": "bun scripts/build-site.ts",
    "test:site": "node scripts/test-landing.mjs && node scripts/test-site.mjs",
    "typecheck:site": "tsc --noEmit --project docs/web/tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "1.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "esbuild": "0.25.12",
    "lucide": "1.57.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
