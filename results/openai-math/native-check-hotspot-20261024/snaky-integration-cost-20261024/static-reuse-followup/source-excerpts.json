      "endLine": 14277,
      "text": "def qinverseRotation (r : Fin 8) : Fin 8 := by\n  set_option maxHeartbeats 0 in\n    set_option maxRecDepth 100000 in\n      exact (if r = 3 then 5 else if r = 5 then 3 else r)\n",
      "sha256": "86d6e4b6ac4c8cdfb77859d8c4910e7cddc855c597ae0642ecd8bfd243e7ad5f"
