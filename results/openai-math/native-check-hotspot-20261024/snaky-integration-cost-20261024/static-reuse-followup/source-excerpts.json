    {
      "name": "qorientEquiv",
      "kind": "def",
      "startLine": 14288,
      "endLine": 14291,
      "text": "def qorientEquiv (r : Fin 8) : qCell ≃ qCell := by\n  set_option maxHeartbeats 0 in\n    set_option maxRecDepth 100000 in\n      exact (⟨qorient r,qorient (qinverseRotation r),qorient_inverse r,qorient_inverse' r⟩)\n",
      "sha256": "12538f1bc9cd8c783a618ec94f4e7ae35ba2ded8b5a04e4d721fef31657e75a4"
    },
    {
      "name": "qplacementEquiv",
