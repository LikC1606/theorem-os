    {
      "name": "qCell",
      "kind": "abbrev",
      "startLine": 363,
      "endLine": 366,
      "text": "abbrev qCell := by\n  set_option maxHeartbeats 0 in\n    set_option maxRecDepth 100000 in\n      exact (ℤ × ℤ)\n",
      "sha256": "2c2a74ae8618d7615177d48bd52df3e17a4dc70e41a4ac025abcac3d2c5450f0"
    },
    {
      "name": "qorient",
      "kind": "def",
      "startLine": 375,
      "endLine": 386,
      "text": "def qorient (r : Fin 8) (p : qCell) : qCell := by\n  set_option maxHeartbeats 0 in\n    set_option maxRecDepth 100000 in\n      exact (match r.val with\n  | 0 => (p.1,p.2)\n  | 1 => (p.2,p.1)\n  | 2 => (p.1,-p.2)\n  | 3 => (-p.2,p.1)\n  | 4 => (-p.1,p.2)\n  | 5 => (p.2,-p.1)\n  | 6 => (-p.1,-p.2)\n  | _ => (-p.2,-p.1))\n",
      "sha256": "709c538def6b27e00a87459a16dbe32c31545af54ab58c7a22aa7f737940deed"
    },
    {
      "name": "qplacement",
      "kind": "def",
      "startLine": 387,
      "endLine": 390,
      "text": "def qplacement (r : Fin 8) (t p : qCell) : qCell := by\n  set_option maxHeartbeats 0 in\n    set_option maxRecDepth 100000 in\n      exact (qorient r p + t)\n",
      "sha256": "f48d3ac4c69f3ceb1e54a8f6dbbd473f1b41863fee43bd1d8508788cd3e4d250"
    },
    {
