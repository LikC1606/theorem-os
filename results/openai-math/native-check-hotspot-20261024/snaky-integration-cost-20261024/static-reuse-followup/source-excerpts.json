    {
      "name": "qsmall_step11",
      "kind": "lemma",
      "startLine": 14206,
      "endLine": 14209,
      "text": "lemma qsmall_step11 : ∀ b ∈ qsmall10,b ∈ (qplaceRow ⟨614,1,4,3⟩ qm614).H → b ∈ qsmall11 := by\n  set_option maxHeartbeats 0 in\n    set_option maxRecDepth 100000 in\n      run_tac qhbGeometry (← `(tactic| decide +kernel))\n",
