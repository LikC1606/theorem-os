      "text": "def qplacementEquiv (r : Fin 8) (t : qCell) : qCell ≃ qCell := by\n  set_option maxHeartbeats 0 in\n    set_option maxRecDepth 100000 in\n      exact ((qorientEquiv r).trans (Equiv.addRight t))\n",
      "sha256": "cc0ca7d03f68ec252649d99e39940b4cf9717837dda37bebb96b8ebc43a2429c"
