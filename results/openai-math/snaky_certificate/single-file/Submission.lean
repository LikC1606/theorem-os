theorem certificate_correct :
    TableValid ∧ placementCount = 1837 ∧
    Output 557 (-1, 0) 118 19 {p | p.1 ≤ -3 ∧ p.2 ≤ -2} ∧
    Output 595 (-1, 0) 222 27 {p | p.1 = -2 ∧ p.2 ≤ -2} ∧
    Output 603 (-1, 0) 275 27 {p | p.1 ≤ -3 ∧ p.2 = 0} ∧
    Output 615 (1, 0) 686 34 {(1, -1)} ∧
    AllRows := by
  set_option maxRecDepth 100000 in
    run_tac qhb (← `(tactic| (
      refine ⟨table_valid_probe, ?_, ?_, ?_, ?_, ?_, memo_allRows⟩
      · decide +kernel
      · unfold Output
        rw [me_557]
        exact ⟨by decide +kernel, by decide +kernel, by decide +kernel, Set.disjoint_left.mpr (fun p hp => mo_557 p hp)⟩
      · unfold Output
        rw [me_595]
        exact ⟨by decide +kernel, by decide +kernel, by decide +kernel, Set.disjoint_left.mpr (fun p hp => mo_595 p hp)⟩
      · unfold Output
        rw [me_603]
        exact ⟨by decide +kernel, by decide +kernel, by decide +kernel, Set.disjoint_left.mpr (fun p hp => mo_603 p hp)⟩
      · unfold Output
        rw [me_615]
        exact ⟨by decide +kernel, by decide +kernel, by decide +kernel, by
          apply Set.disjoint_left.mpr
          intro p hp he
          have h : p = (1,-1) := he
          subst p
          exact mo_615 hp⟩)))

