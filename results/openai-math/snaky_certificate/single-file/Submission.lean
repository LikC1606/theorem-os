def qcompactStep (a : Cell) (xs : List Cell) : List Cell :=
  match xs with
  | [] => [a]
  | b :: bs => if a = b then xs else a :: xs

def qcompact (xs : List Cell) : List Cell := xs.foldr qcompactStep []

lemma qcompactStep_mem (x a : Cell) (xs : List Cell) :
    x ∈ qcompactStep a xs ↔ x = a ∨ x ∈ xs := by
  set_option maxRecDepth 100000 in
    cases xs with
    | nil => simp [qcompactStep]
    | cons b bs =>
        by_cases h : a = b
        · subst b
          simp [qcompactStep,or_assoc,or_self_left]
        · simp [qcompactStep,h]

lemma qcompact_mem (x : Cell) (xs : List Cell) : x ∈ qcompact xs ↔ x ∈ xs := by
  set_option maxRecDepth 100000 in
    induction xs with
    | nil => rfl
    | cons a xs ih => simpa only [qcompact,List.foldr_cons,qcompactStep_mem,List.mem_cons] using or_congr Iff.rfl ih

def qcellLE (a b : Cell) : Bool := decide (a.1 < b.1 ∨ (a.1 = b.1 ∧ a.2 ≤ b.2))

def qmergeFuel (n : ℕ) : List Cell → List Cell → List Cell :=
  Nat.rec (fun xs ys => xs ++ ys) (fun _ rec xs ys => match xs,ys with
    | [],ys => ys
    | xs,[] => xs
    | a :: xs,b :: ys => if qcellLE a b then a :: rec xs (b :: ys) else b :: rec (a :: xs) ys) n

lemma qmergeFuel_mem (x : Cell) (n : ℕ) (xs ys : List Cell) :
    x ∈ qmergeFuel n xs ys ↔ x ∈ xs ∨ x ∈ ys := by
  set_option maxRecDepth 100000 in
    induction n generalizing xs ys with
    | zero => exact List.mem_append
    | succ n ih =>
        cases xs with
        | nil => simp [qmergeFuel]
        | cons a xs =>
            cases ys with
            | nil => simp [qmergeFuel]
            | cons b ys =>
                change x ∈ (if qcellLE a b then a :: qmergeFuel n xs (b :: ys) else b :: qmergeFuel n (a :: xs) ys) ↔ _
                split_ifs <;> simp only [List.mem_cons,ih] <;> tauto

def qmerge (xs ys : List Cell) : List Cell := qmergeFuel (xs.length + ys.length) xs ys

lemma qmerge_mem (x : Cell) (xs ys : List Cell) : x ∈ qmerge xs ys ↔ x ∈ xs ∨ x ∈ ys :=
  qmergeFuel_mem x _ _ _

def qsortFuel (n : ℕ) : List Cell → List Cell :=
  Nat.rec id (fun _ rec xs => match xs with
    | [] => []
    | [a] => [a]
    | a :: b :: xs =>
        qmerge (rec ((a :: b :: xs).take ((xs.length + 3) / 2)))
          (rec ((a :: b :: xs).drop ((xs.length + 3) / 2)))) n

lemma qsortFuel_mem (x : Cell) (n : ℕ) (xs : List Cell) :
    x ∈ qsortFuel n xs ↔ x ∈ xs := by
  set_option maxRecDepth 100000 in
    induction n generalizing xs with
    | zero => rfl
    | succ n ih =>
        cases xs with
        | nil => rfl
        | cons a xs =>
            cases xs with
            | nil => rfl
            | cons b xs =>
                change x ∈ qmerge (qsortFuel n ((a :: b :: xs).take ((xs.length + 3) / 2)))
                  (qsortFuel n ((a :: b :: xs).drop ((xs.length + 3) / 2))) ↔ _
                simp only [qmerge_mem,ih]
                rw [← List.mem_append,List.take_append_drop]

def qsort (xs : List Cell) : List Cell := qsortFuel xs.length xs

lemma qsort_mem (x : Cell) (xs : List Cell) : x ∈ qsort xs ↔ x ∈ xs :=
  qsortFuel_mem x xs.length xs

def qcanonical (xs : List Cell) : List Cell := qcompact (qsort xs)

lemma qcanonical_mem (x : Cell) (xs : List Cell) : x ∈ qcanonical xs ↔ x ∈ xs := by
  set_option maxRecDepth 100000 in
    simp only [qcanonical,qcompact_mem,qsort_mem]

lemma qcanonical_toFinset (xs : List Cell) : (qcanonical xs).toFinset = xs.toFinset := by
  set_option maxRecDepth 100000 in
    ext x
    simp only [List.mem_toFinset,qcanonical_mem]

lemma qrowH_list (xs : List Cell) (h : xs.Nodup) :
    (Finset.mk (xs : Multiset Cell) (Multiset.coe_nodup.mpr h) : Finset Cell) = xs.toFinset := by
  set_option maxRecDepth 100000 in
    exact List.toFinset_eq (Multiset.coe_nodup.mpr h)

lemma qlist_image (xs : List Cell) (f : Cell → Cell) :
    xs.toFinset.image f = (xs.map f).toFinset := by
  set_option maxRecDepth 100000 in
    ext x
    simp only [Finset.mem_image,List.mem_toFinset,List.mem_map]

lemma qlist_unionH (ds : List RowData) (ls : List (List Cell))
    (h : ds.map RowData.H = ls.map List.toFinset) :
    unionH ds = ls.flatten.toFinset := by
  set_option maxRecDepth 100000 in
    unfold unionH
    rw [h]
    clear h ds
    induction ls with
    | nil => simp
    | cons x xs ih => simpa only [List.map_cons,List.foldr_cons,List.flatten_cons,List.toFinset_append] using congrArg (x.toFinset ∪ ·) ih

lemma qlist_H_target (xs ys : List Cell) (h : qcanonical xs = ys) :
    xs.toFinset = ys.toFinset := by
  set_option maxRecDepth 100000 in
    rw [← qcanonical_toFinset xs,h]

lemma spPlacedH_mem (t : Term) (d : RowData) (xs : List Cell)
    (hd : d.H = xs.toFinset) (b : Cell) :
    b ∈ (placeRow t d).H ↔ b ∈ xs.map (placement t.rotation t.shift) := by
  set_option maxRecDepth 100000 in
    change b ∈ d.H.image (placement t.rotation t.shift) ↔ _
    rw [hd,qlist_image]
    exact List.mem_toFinset

lemma qfoldInter_le (ds : List RowData) (S : Finset Cell) : (ds.map RowData.H).foldr (· ∩ ·) S ⊆ S := by
  set_option maxRecDepth 100000 in
    induction ds with
    | nil => exact Finset.Subset.refl S
    | cons d ds ih => exact Finset.Subset.trans Finset.inter_subset_right ih

lemma qfoldInter_member (ds : List RowData) (S : Finset Cell) (d : RowData) (hd : d ∈ ds) :
    (ds.map RowData.H).foldr (· ∩ ·) S ⊆ d.H := by
  set_option maxRecDepth 100000 in
    induction ds with
    | nil => cases hd
    | cons x xs ih =>
        simp only [List.mem_cons] at hd
        rcases hd with h | h
        · subst x
          exact Finset.inter_subset_left
        · exact Finset.Subset.trans Finset.inter_subset_right (ih h)

lemma qcommonH_le (d : RowData) (ds : List RowData) : d ∈ ds → commonH ds ⊆ d.H := by
  set_option maxRecDepth 100000 in
    intro hd
    cases ds with
    | nil => cases hd
    | cons e ds =>
        change (ds.map RowData.H).foldr (· ∩ ·) e.H ⊆ d.H
        simp only [List.mem_cons] at hd
        rcases hd with h | h
        · subst e
          exact qfoldInter_le ds _
        · exact qfoldInter_member ds e.H d h

lemma qcommonH_le_at (ds : List RowData) (i : ℕ) (d : RowData) (h : ds[i]? = some d) : commonH ds ⊆ d.H := by
  set_option maxRecDepth 100000 in
    apply qcommonH_le d ds
    exact List.mem_of_getElem? h

lemma erase_union_eq_of_subset {α : Type*} [DecidableEq α]
    (s t u : Finset α) (o : α)
    (hs : s ⊆ insert o u) (ht : t ⊆ insert o u)
    (hu : u ⊆ s ∪ t) (ho : o ∉ u) :
    (s ∪ t).erase o = u := by
  set_option maxRecDepth 100000 in
    ext x
    constructor
    · intro hx
      obtain ⟨hne, hmem⟩ := Finset.mem_erase.mp hx
      have hbound := (Finset.mem_union.mp hmem).elim (fun h => hs h) (fun h => ht h)
      exact (Finset.mem_insert.mp hbound).resolve_left hne
    · intro hx
      have hne : x ≠ o := by
        intro he
        subst x
        exact ho hx
      exact Finset.mem_erase.mpr ⟨hne, hu hx⟩

lemma erase_union_eq_of_left_subset {α : Type*} [DecidableEq α]
    (s t u : Finset α) (o : α)
    (hs : s ⊆ insert o u) (ht : t ⊆ insert o u)
    (hu : u ⊆ s) (ho : o ∉ u) :
    (s ∪ t).erase o = u := by
  set_option maxRecDepth 100000 in
    apply erase_union_eq_of_subset s t u o hs ht
    · exact fun _ hx => Finset.mem_union_left t (hu hx)
    · exact ho

