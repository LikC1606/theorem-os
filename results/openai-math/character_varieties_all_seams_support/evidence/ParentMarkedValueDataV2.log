OAI.IntegralCharacterVarieties.SurfacePresentation.Diagram.parent_markedLiftSideValue {F S V R K : Type} {arity : S → ℕ}
  [CommRing R] [Field K] (D : OAI.IntegralCharacterVarieties.SurfacePresentation.Diagram F S V arity) (q : S) [Finite V]
  {r : ℕ} (d : OAI.IntegralCharacterVarieties.TwoFlagBand.RankShape (arity q) (arity q) r)
  (hp : D.rank (D.ports.facet ⟨q, none⟩) = r)
