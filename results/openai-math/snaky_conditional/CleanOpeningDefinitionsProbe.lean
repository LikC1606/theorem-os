lemma openingRow_ext (a b : RowData) (ha : a.A = b.A) (hh : a.H = b.H) (ht : a.height = b.height) : a = b := by
  cases a; cases b; simp_all
def moveRow (r : Fin 8) (t : Cell) (d : RowData) : RowData :=
  ⟨d.A.image (placement r t), d.H.image (placement r t), d.height⟩
lemma moveRow_threat (r : Fin 8) (t : Cell) (d : RowData)
    (hd : Threat Goal d.A d.H d.height) :
    Threat Goal (moveRow r t d).A (moveRow r t d).H (moveRow r t d).height := by
  exact threat_map Goal (placementEquiv r t) (goal_map r t) d.A d.H d.height hd
