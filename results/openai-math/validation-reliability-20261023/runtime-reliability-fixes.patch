diff --git a/src/math/leanErrorCapture.ts b/src/math/leanErrorCapture.ts
new file mode 100644
index 0000000..cb56c3b
--- /dev/null
+++ b/src/math/leanErrorCapture.ts
@@ -0,0 +1,64 @@
+import { StringDecoder } from 'node:string_decoder';
+import { parseLeanDiagnosticOutput } from './leanDiagnosticMessages';
+import { limitMathOutput, MATH_PROCESS_OUTPUT_LIMIT } from './mathProcess';
+
+type Channel = 'stdout' | 'stderr';
+
+/** Keep the first compiler error even when later warnings displace the output tail. */
+export function createLeanErrorCapture(limit = MATH_PROCESS_OUTPUT_LIMIT) {
+  const errorLimit = Math.floor(limit / 2);
+  const streams = Object.fromEntries((['stdout', 'stderr'] as const).map(channel => [channel, {
+    decoder: new StringDecoder('utf8'), pending: '', firstError: undefined as string | undefined, collecting: false,
+  }])) as Record<Channel, { decoder: StringDecoder; pending: string; firstError?: string; collecting: boolean }>;
+  let finished = false;
+
+  const line = (channel: Channel, value: string) => {
+    const stream = streams[channel];
+    const message = parseLeanDiagnosticOutput(value).messages[0];
+    const processError = /^(?:error(?:\([^\n)]*\))?:|fatal error:|uncaught exception:|libc\+\+abi:)/u.test(value);
+    if (message || processError) {
+      stream.collecting = false;
+      if (stream.firstError === undefined && (message?.severity === 'error' || processError)) {
+        stream.firstError = limitMathOutput(value, errorLimit, 'head');
+        stream.collecting = message?.format !== 'lean-json';
+      }
+    } else if (stream.collecting) {
+      stream.firstError = limitMathOutput(`${stream.firstError}\n${value}`, errorLimit, 'head');
+    }
+  };
+  const text = (channel: Channel, value: string) => {
+    const stream = streams[channel];
+    if (stream.firstError !== undefined && !stream.collecting) return;
+    let start = 0;
+    for (;;) {
+      const end = value.indexOf('\n', start);
+      stream.pending = limitMathOutput(stream.pending + value.slice(start, end < 0 ? undefined : end), limit, 'head');
+      if (end < 0) return;
+      line(channel, stream.pending.replace(/\r$/u, ''));
+      stream.pending = '';
+      if (stream.firstError !== undefined && !stream.collecting) return;
+      start = end + 1;
+    }
+  };
+  const finish = () => {
+    if (finished) return;
+    finished = true;
+    for (const channel of ['stdout', 'stderr'] as const) {
+      text(channel, streams[channel].decoder.end());
+      if (streams[channel].pending) line(channel, streams[channel].pending);
+    }
+  };
+  return {
+    onOutput(channel: Channel, chunk: Buffer | string) {
+      if (!finished) text(channel, typeof chunk === 'string' ? chunk : streams[channel].decoder.write(chunk));
+    },
+    preview(channel: Channel, output: string): string | undefined {
+      finish();
+      const tail = limitMathOutput(output.trim(), limit);
+      const first = streams[channel].firstError?.trimEnd();
+      if (!first || tail.includes(first)) return tail || undefined;
+      const notice = '\n[... output omitted; final output follows ...]\n';
+      return first + notice + limitMathOutput(tail, Math.max(0, limit - Buffer.byteLength(first + notice)));
+    },
+  };
+}
