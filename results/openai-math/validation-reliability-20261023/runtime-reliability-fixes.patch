diff --git a/tests/leanErrorCapture.test.ts b/tests/leanErrorCapture.test.ts
new file mode 100644
index 0000000..0d82ad5
--- /dev/null
+++ b/tests/leanErrorCapture.test.ts
@@ -0,0 +1,59 @@
+import os from 'node:os';
+import { describe, expect, it } from 'vitest';
+import { createLeanErrorCapture } from '../src/math/leanErrorCapture';
+import { MATH_PROCESS_OUTPUT_LIMIT, runMathProcess } from '../src/math/mathProcess';
+
+describe('first Lean error retention', () => {
+  it.each(['stdout', 'stderr'] as const)('retains the first %s error between long warning streams', async channel => {
+    const capture = createLeanErrorCapture();
+    const script = `const fs = require('node:fs'), fd = ${channel === 'stdout' ? 1 : 2};
+      const warnings = 'Submission.lean:2:1: warning: later warning\\n'.repeat(2000);
+      fs.writeSync(fd, warnings);
+      fs.writeSync(fd, 'Submission.lean:614:1: error: first blocking error 数😀\\ncontext: impossible equality\\n');
+      fs.writeSync(fd, warnings);
+      fs.writeSync(fd, 'Submission.lean:615:1: error: secondary error\\n');
+      process.exitCode = 1;`;
+    const result = await runMathProcess(process.execPath, ['-e', script], {
+      cwd: os.tmpdir(), timeoutMs: 5000, onOutput: capture.onOutput,
+    });
+    expect(result.exitCode).toBe(1);
+    expect(result[channel]).not.toContain('first blocking error');
+    const retained = capture.preview(channel, result[channel])!;
+    expect(retained).toContain('Submission.lean:614:1: error: first blocking error 数😀');
+    expect(retained).toContain('context: impossible equality');
+    expect(retained).toContain('secondary error');
+    expect(retained).not.toContain('�');
+    expect(Buffer.byteLength(retained)).toBeLessThanOrEqual(MATH_PROCESS_OUTPUT_LIMIT);
+  });
+
+  it('handles split UTF-8, oversized earlier lines and an error without a final newline', () => {
+    const capture = createLeanErrorCapture();
+    capture.onOutput('stdout', Buffer.from('x'.repeat(200_000) + '\n'));
+    const error = 'Proof.lean:1:1: error: 数😀 type mismatch';
+    for (const byte of Buffer.from(error)) capture.onOutput('stdout', Buffer.from([byte]));
+    const retained = capture.preview('stdout', 'unrelated tail')!;
+    expect(retained).toContain(error);
+    expect(retained).not.toContain('�');
+    expect(Buffer.byteLength(retained)).toBeLessThanOrEqual(MATH_PROCESS_OUTPUT_LIMIT);
+  });
+
+  it('recognizes JSON errors and leaves warning-only output unchanged', () => {
+    const capture = createLeanErrorCapture();
+    const error = JSON.stringify({ severity: 'error', data: 'unknown identifier', fileName: 'Proof.lean', pos: { line: 1, column: 0 } });
+    capture.onOutput('stdout', error + '\n');
+    capture.onOutput('stderr', 'Proof.lean:2:1: warning: text mentioning error: does not make it an error\n');
+    expect(capture.preview('stdout', 'final output')).toContain(error);
+    expect(capture.preview('stderr', 'last warning')).toBe('last warning');
+  });
+
+  it('keeps process deadlines active while observing compiler output', async () => {
+    const capture = createLeanErrorCapture();
+    const result = await runMathProcess(process.execPath, ['-e',
+      "process.stdout.write('Proof.lean:1:1: error: waiting forever\\n'); setInterval(() => {}, 1000)"], {
+      cwd: os.tmpdir(), timeoutMs: 500, stopGraceMs: 0, onOutput: capture.onOutput,
+    });
+    expect(result.timedOut).toBe(true);
+    expect(result.exitCode).not.toBe(0);
+    expect(capture.preview('stdout', result.stdout)).toContain('waiting forever');
+  });
+});
