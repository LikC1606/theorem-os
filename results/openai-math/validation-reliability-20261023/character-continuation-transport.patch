+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import assert from 'node:assert/strict';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { gzipSync } from 'node:zlib';
+import { parseCooperationPlan } from './runtime/src/solver/tasks';
+import { readDeliveryLines } from './runtime/src/solver/deliveries';
+import { createCharacterSourceTransport } from './character-source-transport';
+
+const stage = import.meta.dir;
+const selection = JSON.parse(fs.readFileSync(path.join(stage, 'active-followup.json'), 'utf8'));
+const state = JSON.parse(fs.readFileSync(selection.output + '.runtime/state.json', 'utf8'));
+const sourceFile = path.resolve(process.argv[2] ?? path.join(stage,
+  '../character-varieties-progress-20261023/GuardCompatibleAllSeamsV3.lean'));
+const receiptFile = path.resolve(process.argv[3] ?? path.join(stage,
+  'character-source-transport-roundtrip-v1.json'));
+assert(!fs.existsSync(receiptFile));
+const source = fs.readFileSync(sourceFile);
+const digest = (bytes: Buffer | string) => crypto.createHash('sha256').update(bytes).digest('hex');
+const id = 'c'.repeat(64);
+const target = state.problem.targets[0];
+const ownedPath = path.posix.join(state.problem.projectRelative, target.proofPath);
+const payload = createCharacterSourceTransport(source, id, ownedPath);
+const proposal = { id, baseVersion: state.cooperation.planVersion, tasks: [{ id, kind: 'goal',
+  objective: payload.objective, dependsOn: [], revision: 999999999,
+  theoremName: target.theoremName, proofPath: target.proofPath }] };
+const normalized = { id, baseVersion: proposal.baseVersion, ...parseCooperationPlan(state.problem, proposal) };
+const line = JSON.stringify(normalized) + '\n';
+assert(Buffer.byteLength(line) <= 64_000);
+const workspace = fs.mkdtempSync(path.join(stage, 'character-transport-fixture-'));
+const destination = path.join(workspace, ownedPath);
+fs.mkdirSync(path.dirname(destination), { recursive: true });
+fs.writeFileSync(destination, '-- disposable owned proof\n');
+const cooperationFile = path.join(workspace, 'COOPERATION.json');
+const peers = [{ id: 'unrelated', objective: 'ordinary context', objectiveDigest: digest('ordinary context') },
+  { id, objective: payload.objective, objectiveDigest: digest(payload.objective) }];
+fs.writeFileSync(cooperationFile, JSON.stringify({ peers }));
+const editLog = path.join(workspace, 'edits.jsonl');
+fs.writeFileSync(editLog, line);
+const consumed = readDeliveryLines(editLog, 0);
+assert.equal(consumed.entries!.length, 1);
+assert.equal(JSON.parse(consumed.entries![0].line!).tasks[0].objective, payload.objective);
+const sandboxArgs = ['--die-with-parent', '--unshare-user', '--unshare-pid', '--unshare-net',
+  '--ro-bind', '/', '/', '--bind', workspace, workspace, '--proc', '/proc', '--chdir', workspace,
+  '/bin/sh', '-c', payload.command];
+const stdout = execFileSync('/usr/bin/bwrap', sandboxArgs, { cwd: workspace, encoding: 'utf8' });
+assert.deepEqual(fs.readFileSync(destination), source);
+const unchanged = fs.readFileSync(destination);
+peers[1].objectiveDigest = '0'.repeat(64);
+fs.writeFileSync(cooperationFile, JSON.stringify({ peers }));
+const rejected = spawnSync('/bin/sh', ['-c', payload.command], { cwd: workspace, encoding: 'utf8' });
+assert.notEqual(rejected.status, 0);
+assert.deepEqual(fs.readFileSync(destination), unchanged);
+const unicodeSource = Buffer.from('-- 中文校验："引号"、反斜线 \\ 与换行\n' + 'λ 中文\n'.repeat(200));
+const unicode = createCharacterSourceTransport(unicodeSource, id, ownedPath);
+fs.writeFileSync(cooperationFile, JSON.stringify({ peers: [{ id, objective: unicode.objective,
+  objectiveDigest: digest(unicode.objective) }] }));
+execFileSync('/bin/sh', ['-c', unicode.command], { cwd: workspace, encoding: 'utf8' });
+assert.deepEqual(fs.readFileSync(destination), unicodeSource);
+const receipt = { observedAt: new Date().toISOString(), passed: true, sourceFile,
+  sourceSHA256: payload.sourceSHA256, sourceBytes: source.length, encoding: payload.encoding,
+  gzipBase64Bytes: Buffer.byteLength(gzipSync(source).toString('base64')),
+  compressedBytes: payload.compressedBytes, compressedSHA256: payload.compressedSHA256,
+  base64Bytes: Math.ceil(payload.compressedBytes / 3) * 4,
+  commandBytes: Buffer.byteLength(payload.command), normalizedEditLineBytes: Buffer.byteLength(line),
+  frozenReaderLineLimitBytes: 64_000, exactFrozenDeliveryReaderConsumedLine: true,
+  sandboxPythonRoundtripPassed: true, sandboxCommand: ['/usr/bin/bwrap', ...sandboxArgs.slice(0, -1), '<generated loader>'],
+  loaderReadFullObjectiveFromCooperation: true, corruptObjectiveDigestRejectedBeforeWrite: true,
+  utf8QuotesAndNewlinesRoundtripPassed: true, workspace,
+  queueExecuted: false, modelInvoked: false, frozenRuntimeModified: false,
+  mathematicalAcceptance: false, nativeAcceptance: false,
+  claimBoundary: 'Exact-byte transport validation only. This source is a transport fixture; no mathematical success or delivery is claimed.' };
+fs.writeFileSync(receiptFile, JSON.stringify(receipt, null, 2) + '\n', { mode: 0o600, flag: 'wx' });
+console.log(JSON.stringify(receipt));
