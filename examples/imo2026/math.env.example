# Copy to a local file and replace paths. Keep Codex credentials in its profile.
ELAN_HOME=/absolute/path/to/.elan
PATH=${ELAN_HOME}/bin:${PATH}
DEEPSCIENTIST_MATH_SANDBOX_BACKEND=bwrap
# For a byte-verified local copy of the pinned bare toolchain, select its root:
# ELAN_HOME=/local/disk/lean-4.31.0-linux
# DEEPSCIENTIST_MATH_TRUSTED_ELAN_ROOTS=${ELAN_HOME}
# LEAN_SYSROOT=${ELAN_HOME}
# Optional: the .lake/packages directory matching the pinned Lake manifest.
# DEEPSCIENTIST_MATH_TRUSTED_CACHE_ROOTS=/absolute/path/to/prepared/project/.lake/packages
